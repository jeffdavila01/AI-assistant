{
  "name": "ai-assistant",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev -- --port 5173 --strictPort",
    "dev:freebuff": "npm --prefix server run freebuff",
    "dev:all": "concurrently --kill-others-on-fail --names SERVER,CLIENT,FREEBUFF npm:dev:server npm:dev:client npm:dev:freebuff"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
